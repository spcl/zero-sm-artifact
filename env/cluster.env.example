# Copy to env/cluster.env and edit. Every script sources env/cluster.env.

# Slurm (read natively by sbatch/srun)
export SBATCH_ACCOUNT=
export SBATCH_PARTITION=
export SLURM_ACCOUNT=$SBATCH_ACCOUNT
export SLURM_PARTITION=$SBATCH_PARTITION
export SBATCH_CONSTRAINT=          # optional node feature, e.g. b200

# Shared directory visible from all nodes: sources, builds, datasets, results
export WORK=

# Platform: b200 (8 GPUs per node, NVLink domain = 1 node)
#           gb200 (4 GPUs per node, NVLink domain = 18 nodes)
export PLATFORM=b200
export GPUS_PER_NODE=8

# Host toolchain for NCCL, nccl-tests, VCCL and MSCCL++ builds
export CUDA_HOME=/usr/local/cuda-12.9
export MPI_HOME=/opt/hpcx/ompi
export NVCC_GENCODE="-gencode=arch=compute_100,code=sm_100"

# Network: list the GPU-local NICs explicitly (one per GPU on B200)
export NCCL_IB_HCA=
export NCCL_SOCKET_IFNAME=

# Containers (pyxis/enroot image references)
export IMG_PYTORCH=nvcr.io#nvidia/pytorch:26.04-py3
export IMG_NEMO=nvcr.io#nvidia/nemo:25.11.01
