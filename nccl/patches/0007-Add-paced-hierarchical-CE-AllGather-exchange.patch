+// Resources shared by the paced algorithm's repeated send-issue calls.
+struct ncclHierCeAllGatherPipeSendCtx {
+  int numCtx;
+  int baseCtx;
+  int* ctxOps;                                 // [numCtx]
+  int* ctxFill;                                // [numCtx]
+  struct ncclRmaProxyDesc** groupDesc;         // [numCtx]
+  struct ncclRmaPutSignalOp** groupOps;        // [numCtx]
+  CUstreamBatchMemOpParams* groupStartParams;  // [numCtx * startOps]
+  CUstreamBatchMemOpParams* groupDoneParams;   // [(nNodes-1) * numCtx * doneOps]
+  int nDoneGroups;
+};
+
+// Build this rank's slice put group to sendPeer, spread its chunks across the
+// internal contexts, and fire this peer's start memops.
+static ncclResult_t ncclHierCeAllGatherPipeIssueSend(struct ncclComm* comm, struct ncclKernelPlan* plan,
+                                                     cudaStream_t stream,
+                                                     const struct ncclHierChunkPlan* chunkPlan,
+                                                     struct ncclHierCeAllGatherPipeSendCtx* sendCtx, int sendPeer) {
+  ncclResult_t ret = ncclSuccess;
+  struct ncclCeCollArgs* args = plan->ceCollArgs;
+  struct ncclRmaProxyState* rmaProxyState = &comm->rmaState.rmaProxyState;
+  bool persistent = plan->persistent;
+  struct ncclDevrWindow* sendWin = args->sendWin;
+  struct ncclDevrWindow* recvWin = args->recvWin;
+  size_t perRankBytes = args->nElts * args->eltSize;
+  size_t srcWinOffset = (const uint8_t*)args->sendBuff - (const uint8_t*)sendWin->userPtr;
+  size_t peerWinOffset =
+    ((const uint8_t*)args->recvBuff + (size_t)comm->rank * perRankBytes) - (const uint8_t*)recvWin->userPtr;
+  int numCtx = sendCtx->numCtx;
+  int baseCtx = sendCtx->baseCtx;
+  int nChunks = chunkPlan->chunkStart[1];
+  int startOps = ncclRmaProxyPutGroupStartNumOps(persistent);
+  int doneOps = ncclRmaProxyPutGroupDoneNumOps(persistent);
+  int nActiveCtx = 0;
+
+  memset(sendCtx->ctxOps, 0, (size_t)numCtx * sizeof(int));
+  memset(sendCtx->ctxFill, 0, (size_t)numCtx * sizeof(int));
+  for (int c = 0; c < nChunks; c++) sendCtx->ctxOps[c % numCtx]++;
+
+  for (int k = 0; k < numCtx; k++) {
+    if (sendCtx->ctxOps[k] == 0) continue;
+    NCCLCHECKGOTO(ncclCalloc(&sendCtx->groupOps[k], sendCtx->ctxOps[k]), ret, fail);
+    NCCLCHECKGOTO(ncclCalloc(&sendCtx->groupDesc[k], 1), ret, fail);
+  }
+
+  for (int c = 0; c < nChunks; c++) {
+    int k = c % numCtx;
+    size_t subBytes = chunkPlan->chunkBytes[c];
+    size_t off = chunkPlan->chunkOff[c];
+    NCCLCHECKGOTO(ncclRmaProxyPutBuildOp(comm, (struct ncclRmaProxyCtx*)rmaProxyState->rmaProxyCtxs[baseCtx + k],
+                                         baseCtx + k, persistent, sendWin, srcWinOffset + off, recvWin,
+                                         peerWinOffset + off, subBytes, sendPeer, /*signalIdx=*/0, NCCL_SIGNAL,
+                                         &sendCtx->groupOps[k][sendCtx->ctxFill[k]++]),
+                  ret, fail);
+  }
+
+  for (int k = 0; k < numCtx; k++) {
+    if (sendCtx->ctxOps[k] == 0) continue;
+    struct ncclRmaProxyCtx* proxyCtx = (struct ncclRmaProxyCtx*)rmaProxyState->rmaProxyCtxs[baseCtx + k];
+    NCCLCHECKGOTO(ncclRmaProxyPutGroupBuildDesc(comm, proxyCtx, plan, sendCtx->ctxOps[k], &sendCtx->groupOps[k],
+                                                baseCtx + k, sendCtx->groupDesc[k]),
+                  ret, fail);
+    NCCLCHECKGOTO(ncclRmaProxyPutGroupStartParams(sendCtx->groupDesc[k],
+                                                  sendCtx->groupStartParams + nActiveCtx * startOps),
+                  ret, fail);
+    NCCLCHECKGOTO(ncclRmaProxyPutGroupDoneParams(sendCtx->groupDesc[k],
+                                                 sendCtx->groupDoneParams + sendCtx->nDoneGroups * doneOps),
+                  ret, fail);
+    NCCLCHECKGOTO(ncclRmaProxyEnqueueDesc(proxyCtx, &sendCtx->groupDesc[k]), ret, fail);
+    nActiveCtx++;
+    sendCtx->nDoneGroups++;
+  }
+  NCCLCHECKGOTO(ncclCuStreamBatchMemOp(stream, nActiveCtx * startOps, sendCtx->groupStartParams), ret, fail);
+exit:
+  return ret;
+fail:
+  goto exit;
+}
+
+// Paced direct all-to-all variant of the hierarchical AllGather rail exchange.
+// It keeps only a bounded number of peer sends in flight and clocks each later
+// send from observed receive progress.
+static ncclResult_t ncclHierCeAllGatherPipe(struct ncclComm* comm, struct ncclKernelPlan* plan, cudaStream_t stream) {
+  ncclResult_t ret = ncclSuccess;
+  struct ncclHierCeAllGatherPipeSendCtx sendCtx = {};
+  struct ncclHierChunkPlan chunkPlan = {};
+  struct ncclHierChunkPlan tailChunkPlan = {};
+  struct ncclCeBatchOpsParams batchOps = {};
+
+  struct ncclRmaProxyState* rmaProxyState = &comm->rmaState.rmaProxyState;
+  struct ncclCeCollArgs* args = plan->ceCollArgs;
+  const void* sendbuff = args->sendBuff;
+  void* recvbuff = args->recvBuff;
+  struct ncclDevrWindow* recvWin = args->recvWin;
+  size_t perRankBytes = args->nElts * args->eltSize;
+  int myRank = comm->rank;
+  int localRank = comm->localRank;
+  int nNodes = comm->nNodes;
+  int nRemoteNodes = nNodes - 1;
+  int numCtx = ncclHierCollNumCtx(rmaProxyState, perRankBytes, plan->persistent);
+  int baseCtx = comm->config.numRmaCtx;
+  int startOps = ncclRmaProxyPutGroupStartNumOps(plan->persistent);
+  int doneOps = ncclRmaProxyPutGroupDoneNumOps(plan->persistent);
+  size_t maxChunk;
+  int lsaSize = comm->devrState.lsaSize;
+  int myLsaRank = comm->devrState.lsaSelf;
+  bool agUseMulticast =
+    ncclCeAllGatherUseMulticast(comm, perRankBytes, ncclCudaGraphValid(comm->planner.capturingGraph),
+                                (const uint8_t*)sendbuff == (const uint8_t*)recvbuff + (size_t)myRank * perRankBytes);
+  int copiesPerChunk = agUseMulticast ? 1 : std::max(lsaSize - 1, 0);
+  int64_t depthOverride = ncclParamHierCeCollAgRailPipeDepth();
+  int depth = depthOverride > 0 ? (int)depthOverride : (nNodes >= 16 ? 4 : 1);
+  if (depth > nRemoteNodes) depth = nRemoteNodes;
+
+  sendCtx.numCtx = numCtx;
+  sendCtx.baseCtx = baseCtx;
+  NCCLCHECKGOTO(ncclCalloc(&sendCtx.ctxOps, numCtx), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&sendCtx.ctxFill, numCtx), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&sendCtx.groupDesc, numCtx), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&sendCtx.groupOps, numCtx), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&sendCtx.groupStartParams, (size_t)numCtx * startOps), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&sendCtx.groupDoneParams, (size_t)nRemoteNodes * numCtx * doneOps), ret, fail);
+
+  // ====================================================================
+  // Phase 1: Rail sync (cross-node entry barrier)
+  // ====================================================================
+  NCCLCHECKGOTO(ncclRailSync(comm, (struct ncclRmaProxyCtx*)rmaProxyState->rmaProxyCtxs[baseCtx], plan, baseCtx,
+                             stream),
+                ret, fail);
+
+  maxChunk = ncclHierCollChunkWidth(perRankBytes, numCtx);
+  NCCLCHECKGOTO(ncclHierCollBuildChunk(perRankBytes, 1, maxChunk, &chunkPlan), ret, fail);
+  if (ncclParamHierCeCollAgGeometricTail() != 0) {
+    NCCLCHECKGOTO(ncclHierCollBuildGeometricTail(&chunkPlan, numCtx, HIER_COLL_GEOMETRIC_TAIL_MIN_CHUNK,
+                                                 &tailChunkPlan),
+                  ret, fail);
+  }
+
+  // ====================================================================
+  // Phase 2: Start initial inter-node puts (one group descriptor per context and peer)
+  // ====================================================================
+  for (int s = 1; s <= depth; s++) {
+    int sendNode = (comm->node + s) % nNodes;
+    const struct ncclHierChunkPlan* sendPlan =
+      tailChunkPlan.chunkStart != nullptr && s == nRemoteNodes ? &tailChunkPlan : &chunkPlan;
+    NCCLCHECKGOTO(ncclHierCeAllGatherPipeIssueSend(comm, plan, stream, sendPlan, &sendCtx,
+                                                   comm->nodeRanks[sendNode].localRankToRank[localRank]),
+                  ret, fail);
+  }
+
+  // ====================================================================
+  // Phase 3: Initial intra-node barrier
+  // ====================================================================
+  NCCLCHECKGOTO(ncclMemOpSync(comm, stream, args), ret, fail);
+
+  // ====================================================================
+  // Phase 4: Self-broadcast (intra-node CE broadcast of own chunk)
+  // ====================================================================
+  {
+    uint8_t* selfSlot = (uint8_t*)recvbuff + (size_t)myRank * perRankBytes;
+    size_t selfOffset = selfSlot - (uint8_t*)recvWin->userPtr;
+    NCCLCHECKGOTO(ncclCeLsaBcast(comm, args, stream, recvWin, selfOffset, sendbuff, perRankBytes, agUseMulticast), ret,
+                  fail);
+  }
+
+  // ====================================================================
+  // Phase 5: Consume inbound chunks, issue remaining puts, and scatter locally
+  // ====================================================================
+  for (int s = 1; s < nNodes; s++) {
+    int nextSendStep = s + depth;
+    int nextSendPeer = -1;
+    if (nextSendStep <= nRemoteNodes) {
+      int sendNode = (comm->node + nextSendStep) % nNodes;
+      nextSendPeer = comm->nodeRanks[sendNode].localRankToRank[localRank];
+    }
+
+    const struct ncclHierChunkPlan* recvPlan =
+      tailChunkPlan.chunkStart != nullptr && s == nRemoteNodes ? &tailChunkPlan : &chunkPlan;
+    const struct ncclHierChunkPlan* sendPlan =
+      tailChunkPlan.chunkStart != nullptr && nextSendStep == nRemoteNodes ? &tailChunkPlan : &chunkPlan;
+    int recvNode = (comm->node - s + nNodes) % nNodes;
+    int recvPeer = comm->nodeRanks[recvNode].localRankToRank[localRank];
+    int nChunks = recvPlan->chunkStart[1];
+
+    if (copiesPerChunk > 0 && nChunks > 0) {
+      int waveChunks = std::min(nChunks, numCtx);
+      NCCLCHECKGOTO(ncclCeInitBatchOpsParams(&batchOps, waveChunks * copiesPerChunk), ret, fail);
+    }
+
+    for (int c = 0; c < nChunks; c++) {
+      size_t subBytes = recvPlan->chunkBytes[c];
+      size_t off = recvPlan->chunkOff[c];
+      int k = c % numCtx;
+
+      NCCLCHECKGOTO(ncclProxyWaitOnePeer(comm, (struct ncclRmaProxyCtx*)rmaProxyState->rmaProxyCtxs[baseCtx + k],
+                                         plan, stream, recvPeer, /*nsignals=*/1),
+                    ret, fail);
+
+      if (c == 0 && nextSendPeer >= 0) {
+        NCCLCHECKGOTO(ncclHierCeAllGatherPipeIssueSend(comm, plan, stream, sendPlan, &sendCtx, nextSendPeer), ret,
+                      fail);
+      }
+
+      uint8_t* chunkSlot = (uint8_t*)recvbuff + (size_t)recvPeer * perRankBytes + off;
+      size_t winOffset = chunkSlot - (uint8_t*)recvWin->userPtr;
+      if (agUseMulticast) {
+        void* mcDstPtr = nullptr;
+        NCCLCHECKGOTO(ncclDevrGetLsaTeamPtrMC(comm, recvWin, winOffset, ncclTeamLsa(comm), &mcDstPtr), ret, fail);
+        batchOps.srcs[batchOps.numOps] = chunkSlot;
+        batchOps.dsts[batchOps.numOps] = mcDstPtr;
+        batchOps.sizes[batchOps.numOps++] = subBytes;
+      } else {
+        for (int r = 1; r < lsaSize; r++) {
+          int targetLsaRank = (myLsaRank + r) % lsaSize;
+          void* peerBuf = nullptr;
+          NCCLCHECKGOTO(ncclDevrGetLsaRankPtr(comm, recvWin, winOffset, targetLsaRank, &peerBuf), ret, fail);
+          batchOps.srcs[batchOps.numOps] = chunkSlot;
+          batchOps.dsts[batchOps.numOps] = peerBuf;
+          batchOps.sizes[batchOps.numOps++] = subBytes;
+        }
+      }
+
+      bool waveDone = ((c + 1) % numCtx == 0) || c + 1 == nChunks;
+      if (waveDone && batchOps.numOps > 0) {
+        NCCLCHECKGOTO(ncclCeLaunchBatchOps(comm, &batchOps, stream, args), ret, fail);
+        batchOps.numOps = 0;
+      }
+    }
+    ncclCeFreeBatchOpsParams(&batchOps);
+  }
+
+  // ====================================================================
+  // Phase 6: Wait for all outgoing data puts to complete
+  // ====================================================================
+  NCCLCHECKGOTO(ncclCuStreamBatchMemOp(stream, sendCtx.nDoneGroups * doneOps, sendCtx.groupDoneParams), ret, fail);
+
+  // ====================================================================
+  // Phase 7: Final intra-node barrier
+  // ====================================================================
+  NCCLCHECKGOTO(ncclMemOpSync(comm, stream, args), ret, fail);
+
+exit:
+  ncclCeFreeBatchOpsParams(&batchOps);
+  for (int k = 0; sendCtx.groupOps && k < numCtx; k++) free(sendCtx.groupOps[k]);
+  if (sendCtx.groupDesc) {
+    for (int k = 0; k < numCtx; k++) {
+      if (sendCtx.groupDesc[k] != nullptr) (void)ncclRmaProxyDestroyDesc(comm, &sendCtx.groupDesc[k]);
+    }
+  }
+  free(sendCtx.groupOps);
+  free(sendCtx.groupStartParams);
+  free(sendCtx.groupDoneParams);
+  free(sendCtx.groupDesc);
+  free(sendCtx.ctxOps);
+  free(sendCtx.ctxFill);
+  ncclHierCollFreeChunkPlan(&chunkPlan);
+  ncclHierCollFreeChunkPlan(&tailChunkPlan);
+  return ret;
+fail:
+  goto exit;
+}
+
 struct ncclHierCeAllGatherRingRound {
   int originRankSendCw;
   int originRankSendCcw;
