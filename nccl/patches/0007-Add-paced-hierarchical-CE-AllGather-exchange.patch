+static ncclResult_t ncclCeLsaBcast(struct ncclComm* comm, struct ncclCeCollArgs* args, cudaStream_t stream,
+                                   struct ncclDevrWindow* dstWin, size_t winOffset, const void* srcPtr, size_t bytes,
+                                   bool useMulticast) {
+  ncclResult_t ret = ncclSuccess;
+  int lsaSize = comm->devrState.lsaSize;
+  int myLsaRank = comm->devrState.lsaSelf;
+  struct ncclCeBatchOpsParams ops = {};
+  NCCLCHECKGOTO(ncclCeInitBatchOpsParams(&ops, lsaSize), ret, fail);
+  if (useMulticast) {
+    void* mcDstPtr;
+    NCCLCHECKGOTO(ncclDevrGetLsaTeamPtrMC(comm, dstWin, winOffset, ncclTeamLsa(comm), &mcDstPtr), ret, fail);
+    ops.srcs[ops.numOps] = (void*)srcPtr;
+    ops.dsts[ops.numOps] = mcDstPtr;
+    ops.sizes[ops.numOps++] = bytes;
+  } else {
+    uint8_t* selfDst = (uint8_t*)dstWin->userPtr + winOffset;
+    if ((const uint8_t*)srcPtr != selfDst) {
+      ops.srcs[ops.numOps] = (void*)srcPtr;
+      ops.dsts[ops.numOps] = selfDst;
+      ops.sizes[ops.numOps++] = bytes;
+    }
+    for (int r = 1; r < lsaSize; r++) {
+      int targetLsaRank = (myLsaRank + r) % lsaSize;
+      void* peerBuf;
+      NCCLCHECKGOTO(ncclDevrGetLsaRankPtr(comm, dstWin, winOffset, targetLsaRank, &peerBuf), ret, fail);
+      ops.srcs[ops.numOps] = (void*)srcPtr;
+      ops.dsts[ops.numOps] = peerBuf;
+      ops.sizes[ops.numOps++] = bytes;
+    }
+  }
+  NCCLCHECKGOTO(ncclCeLaunchBatchOps(comm, &ops, stream, args), ret, fail);
+exit:
+  ncclCeFreeBatchOpsParams(&ops);
+  return ret;
+fail:
+  goto exit;
+}
