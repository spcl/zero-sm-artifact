 // AllGather across the LSA team (intra-node only).
 ncclResult_t ncclCeAllGather(struct ncclComm* comm, struct ncclCeCollArgs* args, cudaStream_t stream) {
   ncclResult_t ret = ncclSuccess;
@@ -1169,6 +1221,87 @@ fail:
   goto exit;
 }
 
+// Replace the final complete context wave with large-to-small geometric
+// sub-waves. Keeping every sub-wave at exactly numCtx chunks preserves the
+// existing chunk-index-to-context mapping and lets the receive path batch each
+// level into one CE launch.
+static ncclResult_t ncclHierCollBuildGeometricTail(const struct ncclHierChunkPlan* basePlan, int numCtx,
+                                                   size_t minChunk, struct ncclHierChunkPlan* outPlan) {
+  ncclResult_t ret = ncclSuccess;
+  size_t* remaining = nullptr;
+  size_t* consumed = nullptr;
+  int nChunks = basePlan->nPeers == 1 ? basePlan->chunkStart[1] : 0;
+
+  outPlan->nPeers = 0;
+  outPlan->chunkStart = nullptr;
+  outPlan->chunkBytes = nullptr;
+  outPlan->chunkOff = nullptr;
+
+  // A complete, naturally aligned context wave is required so repeated levels
+  // retain c % numCtx on both the sender and receiver.
+  if (numCtx <= 0 || nChunks < numCtx || nChunks % numCtx != 0 || minChunk == 0) return ncclSuccess;
+
+  int leadingChunks = nChunks - numCtx;
+  size_t minTailBytes = basePlan->chunkBytes[leadingChunks];
+  for (int k = 1; k < numCtx; k++) {
+    minTailBytes = std::min(minTailBytes, basePlan->chunkBytes[leadingChunks + k]);
+  }
+
+  // Each non-final level consumes half of what remains. Stop once another
+  // split would make either side smaller than the configured floor.
+  int nLevels = 1;
+  size_t levelBytes = minTailBytes;
+  while (levelBytes >= 2 * minChunk) {
+    size_t part = (levelBytes / 2 / HIER_COLL_CHUNK_ALIGN) * HIER_COLL_CHUNK_ALIGN;
+    if (part < minChunk || levelBytes - part < minChunk) break;
+    levelBytes -= part;
+    nLevels++;
+  }
+  if (nLevels == 1) return ncclSuccess;
+
+  int totalChunks = leadingChunks + numCtx * nLevels;
+  outPlan->nPeers = 1;
+  NCCLCHECKGOTO(ncclCalloc(&outPlan->chunkStart, 2), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&outPlan->chunkBytes, totalChunks), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&outPlan->chunkOff, totalChunks), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&remaining, numCtx), ret, fail);
+  NCCLCHECKGOTO(ncclCalloc(&consumed, numCtx), ret, fail);
+
+  outPlan->chunkStart[0] = 0;
+  outPlan->chunkStart[1] = totalChunks;
+  for (int c = 0; c < leadingChunks; c++) {
+    outPlan->chunkBytes[c] = basePlan->chunkBytes[c];
+    outPlan->chunkOff[c] = basePlan->chunkOff[c];
+  }
+  for (int k = 0; k < numCtx; k++) remaining[k] = basePlan->chunkBytes[leadingChunks + k];
+
+  for (int level = 0; level < nLevels; level++) {
+    for (int k = 0; k < numCtx; k++) {
+      size_t part = remaining[k];
+      if (level + 1 < nLevels) {
+        part = (remaining[k] / 2 / HIER_COLL_CHUNK_ALIGN) * HIER_COLL_CHUNK_ALIGN;
+      }
+      int dst = leadingChunks + level * numCtx + k;
+      outPlan->chunkBytes[dst] = part;
+      outPlan->chunkOff[dst] = basePlan->chunkOff[leadingChunks + k] + consumed[k];
+      consumed[k] += part;
+      remaining[k] -= part;
+    }
+  }
+exit:
+  free(remaining);
+  free(consumed);
+  return ret;
+fail:
+  free(outPlan->chunkStart);
+  outPlan->chunkStart = nullptr;
+  free(outPlan->chunkBytes);
+  outPlan->chunkBytes = nullptr;
+  free(outPlan->chunkOff);
+  outPlan->chunkOff = nullptr;
+  goto exit;
+}
