+// Append one independent copy to the fused plan and saturate the byte
+// accumulator used only for the existing intra-batch synchronization policy.
+static void ncclCeAllGatherPlanAppendCopy(struct ncclCeBatchOpsParams* ops, void* dst, void* src, size_t bytes,
+                                          size_t* totalBytes) {
+  ops->srcs[ops->numOps] = src;
+  ops->dsts[ops->numOps] = dst;
+  ops->sizes[ops->numOps] = bytes;
+  ops->numOps++;
+  *totalBytes = bytes > SIZE_MAX - *totalBytes ? SIZE_MAX : *totalBytes + bytes;
+}
+
+// Execute independent eager local AllGathers with one entry barrier, one copy
+// submission, and one completion barrier. Algorithm selection remains per
+// member: every AllGather independently uses the existing CE unicast or
+// multicast cost-model result.
+static ncclResult_t ncclCeAllGatherPlan(struct ncclComm* comm, struct ncclKernelPlan* plan, cudaStream_t stream) {
+  ncclResult_t ret = ncclSuccess;
+  int nTasks = plan->nCeColls;
+  int myLsaRank = comm->devrState.lsaSelf;
+  int lsaSize = comm->devrState.lsaSize;
+  size_t totalCopyBytes = 0;
+  bool hasUnicast = false;
+  struct ncclCeBatchOpsParams ops = {};
+  CUstreamBatchMemOpParams* syncOps =
+    ncclMemoryStackAlloc<CUstreamBatchMemOpParams>(&comm->memScoped, ncclMemOpSyncBatchCapacity(comm));
+
+  ncclCeInitBatchOpsParamsScoped(comm, &ops, nTasks * lsaSize);
+  plan->ceCollIndex = 0;
+  NCCLCHECKGOTO(ncclMemOpSyncWithScratch(comm, stream, &plan->ceCollArgs[0], syncOps), ret, fail);
+
+  for (int i = 0; i < nTasks; i++) {
+    struct ncclCeCollArgs* args = &plan->ceCollArgs[i];
+    size_t bytes = args->nElts * args->eltSize;
+    uint8_t* send = (uint8_t*)args->sendBuff;
+    uint8_t* selfDst = (uint8_t*)args->recvBuff + (size_t)myLsaRank * bytes;
+    size_t winOffset = selfDst - (uint8_t*)args->recvWin->userPtr;
+    bool multicast = ncclCeAllGatherUseMulticast(comm, bytes,
+                                                  ncclCudaGraphValid(comm->planner.capturingGraph),
+                                                  send == selfDst);
+
+    if (multicast) {
+      void* mcDst = nullptr;
+      NCCLCHECKGOTO(ncclDevrGetLsaTeamPtrMC(comm, args->recvWin, winOffset, ncclTeamLsa(comm), &mcDst), ret, fail);
+      ncclCeAllGatherPlanAppendCopy(&ops, mcDst, send, bytes, &totalCopyBytes);
+      continue;
+    }
+
+    hasUnicast = true;
+    if (send != selfDst) ncclCeAllGatherPlanAppendCopy(&ops, selfDst, send, bytes, &totalCopyBytes);
+    for (int r = 1; r < lsaSize; r++) {
+      int target = (myLsaRank + r) % lsaSize;
+      void* peerDst = nullptr;
+      NCCLCHECKGOTO(ncclDevrGetLsaRankPtr(comm, args->recvWin, winOffset, target, &peerDst), ret, fail);
+      ncclCeAllGatherPlanAppendCopy(&ops, peerDst, send, bytes, &totalCopyBytes);
+    }
+  }
+
+  ops.intraBatchSync = hasUnicast && ops.numOps > comm->ceColl.intraBatchSyncFreq &&
+                       totalCopyBytes >= comm->ceColl.intraBatchSyncMsgThreshold;
+  NCCLCHECKGOTO(ncclCeLaunchBatchOps(comm, &ops, stream, &plan->ceCollArgs[0]), ret, fail);
+  NCCLCHECKGOTO(ncclMemOpSyncWithScratch(comm, stream, &plan->ceCollArgs[0], syncOps), ret, fail);
+
+  if (comm->rank == 0) {
+    INFO(NCCL_TUNING,
+         "CE plan protocol-fused %d local AllGather tasks into %zu copy operations (scoped copy/sync scratch)",
+         nTasks, ops.numOps);
+  }
+
+exit:
+  plan->ceCollIndex = 0;
+  return ret;
+fail:
+  goto exit;
+}
