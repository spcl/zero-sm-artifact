+static bool ncclCeRangesOverlap(const void* a, size_t aBytes, const void* b, size_t bBytes) {
+  if (aBytes == 0 || bBytes == 0) return false;
+  uintptr_t aBegin = reinterpret_cast<uintptr_t>(a);
+  uintptr_t bBegin = reinterpret_cast<uintptr_t>(b);
+  uintptr_t aEnd = aBegin + aBytes;
+  uintptr_t bEnd = bBegin + bBytes;
+  // An overflowing range is not safe to reason about, so make the fusion
+  // eligibility check fail closed.
+  if (aEnd < aBegin || bEnd < bBegin) return true;
+  return aBegin < bEnd && bBegin < aEnd;
+}
+
+// cudaMemcpyBatchAsync does not order copies within a batch. Preserve the
+// observable order of grouped NCCL calls by fusing only AllGathers whose
+// output ranges are independent from every other member's inputs and outputs.
+// Read-only send ranges may overlap each other.
+static bool ncclCeAllGatherPlanBuffersIndependent(struct ncclComm* comm, struct ncclKernelPlan* plan) {
+  for (int i = 0; i < plan->nCeColls; i++) {
+    struct ncclCeCollArgs* a = &plan->ceCollArgs[i];
+    size_t aSendBytes = a->nElts * a->eltSize;
+    if (a->eltSize != 0 && aSendBytes / a->eltSize != a->nElts) return false;
+    size_t aRecvBytes = aSendBytes * comm->nRanks;
+    if (comm->nRanks != 0 && aRecvBytes / comm->nRanks != aSendBytes) return false;
+
+    for (int j = 0; j < i; j++) {
+      struct ncclCeCollArgs* b = &plan->ceCollArgs[j];
+      size_t bSendBytes = b->nElts * b->eltSize;
+      if (b->eltSize != 0 && bSendBytes / b->eltSize != b->nElts) return false;
+      size_t bRecvBytes = bSendBytes * comm->nRanks;
+      if (comm->nRanks != 0 && bRecvBytes / comm->nRanks != bSendBytes) return false;
+
+      if (ncclCeRangesOverlap(a->recvBuff, aRecvBytes, b->recvBuff, bRecvBytes) ||
+          ncclCeRangesOverlap(a->sendBuff, aSendBytes, b->recvBuff, bRecvBytes) ||
+          ncclCeRangesOverlap(a->recvBuff, aRecvBytes, b->sendBuff, bSendBytes)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+static bool ncclCeAllGatherUsePlanFusion(struct ncclComm* comm, struct ncclKernelPlan* plan) {
+  if (plan->persistent || plan->nCeColls < 2 || ncclParamCeAllGatherPlanFusion() == 0 ||
+      !ncclDevrIsOneLsaTeam(comm)) {
+    return false;
+  }
+  for (int i = 0; i < plan->nCeColls; i++) {
+    if (plan->ceCollArgs[i].func != ncclFuncAllGather) return false;
+  }
+  return ncclCeAllGatherPlanBuffersIndependent(comm, plan);
+}
