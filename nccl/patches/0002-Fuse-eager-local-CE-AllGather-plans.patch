+// Eager plan callbacks finish before ncclGroupCommLeave() releases memScoped.
+// Use that lifetime for launch-only copy arrays instead of allocating and
+// freeing several small heap blocks on every group submission.
+static void ncclCeInitBatchOpsParamsScoped(struct ncclComm* comm, struct ncclCeBatchOpsParams* params,
+                                           int capacity) {
+  params->srcs = ncclMemoryStackAlloc<void*>(&comm->memScoped, capacity);
+  params->dsts = ncclMemoryStackAlloc<void*>(&comm->memScoped, capacity);
+  params->sizes = ncclMemoryStackAlloc<size_t>(&comm->memScoped, capacity);
+  params->numOps = 0;
+  params->intraBatchSync = false;
+#if CUDART_VERSION >= 12080
+  params->attrs = ncclMemoryStackAlloc<cudaMemcpyAttributes>(&comm->memScoped, capacity);
+  params->attrIdxs = ncclMemoryStackAlloc<size_t>(&comm->memScoped, capacity);
+  params->numAttrs = 0;
+#endif
+}
