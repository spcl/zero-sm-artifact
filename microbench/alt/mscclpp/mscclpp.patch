diff --git a/src/core/include/execution_common.hpp b/src/core/include/execution_common.hpp
index 6ce47d8f..58f96b27 100644
--- a/src/core/include/execution_common.hpp
+++ b/src/core/include/execution_common.hpp
@@ -14,7 +14,10 @@ constexpr int MAX_LOCAL_BUFFER_PER_OPERATION = 2;
 
 constexpr int MAX_CHANNEL = 16;
 constexpr int MAX_CHANNEL_PER_OPERATION = 8;
-constexpr int MAX_OPERATION = 64;
+// The multi-node Simple/TBG AllGather plans emit up to 255 operations per
+// thread block at 64 ranks; the default of 64 rejects them. The plan stays
+// fixed-size and exceeds 48 KiB, hence the shared-memory attribute below.
+constexpr int MAX_OPERATION = 256;
 
 constexpr int MAX_DEVICE_SYNCERS = 16;
 constexpr int MAX_DEVICE_SEMAPHORES = 16;
@@ -144,7 +147,7 @@ struct __attribute__((aligned(16))) DeviceExecutionPlan {
   uint16_t nOperations;                 // 2 bytes
   Channels channels;                    // 1792 bytes
   RemoteBuffers remoteBuffers;          // 224 bytes
-  Operation operations[MAX_OPERATION];  // 64 * 160 = 10240 bytes
+  Operation operations[MAX_OPERATION];  // 256 * 160 = 40960 bytes
 };
 
 }  // namespace mscclpp
