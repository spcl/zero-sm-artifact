# DeepSeek-V3 image (FSDP and PP recipes). Equivalent to e2e/pp/build_deps.sh with DEPS_TARGETS=deepseek,
# for clusters that build images with Docker instead of installing into $WORK/build/pp-deps.
FROM nvcr.io/nvidia/pytorch:26.08-py3

ENV PIP_CONSTRAINT= MAX_JOBS=24 TORCH_CUDA_ARCH_LIST="10.0;10.3;12.0"

RUN NVTE_FRAMEWORK=pytorch NVTE_CUDA_ARCHS="100a" pip install --no-deps --no-build-isolation \
      "git+https://github.com/NVIDIA/TransformerEngine.git@6ea2a74a9e98c99e6d7b164a33775cc457520027" && \
    pip install nvidia-cudnn-frontend==1.27.0 "nvidia-cutlass-dsl[cu13]==4.8.0" && \
    sed -i "s/deterministic_dactivation = (/deterministic_dactivation = False and (/" \
      "$(python3 -c 'import transformer_engine.pytorch.ops.fused.grouped_mlp as m; print(m.__file__)')"

RUN git clone https://github.com/deepseek-ai/DeepEP.git /opt/deepep && \
    cd /opt/deepep && git checkout 94a9f8f6b146c07d97ec58f67cd6d303296d6098 && \
    CPLUS_INCLUDE_PATH=/usr/local/cuda/include/cccl pip install --no-deps --no-build-isolation .

RUN pip install \
      "git+https://github.com/mlcommons/logging.git@6.0.0-rc3" \
      "git+https://github.com/NVIDIA/mlperf-common.git@c02c93c0414071400a10716d9cd5cb8f668b78d4" \
      transformers==5.5.4 blobfile==3.0.0 prettytable==3.11.0 omegaconf==2.3.0 hydra-core==1.3.2 wandb==0.23.0 \
      nvidia-resiliency-ext==0.6.0 megatron-energon==6.0.1 bitstring==4.3.1 filetype==1.2.0 datasets==4.4.1 \
      diffusers==0.37.1 einops==0.8.1 accelerate==1.10.1 peft==0.18.1 mistral-common==1.10.0 tensorboard==2.20.0 \
      timm==1.0.20 open-clip-torch==3.2.0 qwen-vl-utils==0.0.14

RUN git clone https://github.com/NVIDIA-NeMo/Megatron-Bridge.git /opt/megatron-bridge && \
    cd /opt/megatron-bridge && git checkout c70593623dd8f25474d58740815e6bf48d4c6ef2
