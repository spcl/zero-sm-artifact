+class DeltaTimer:
+    def __init__(self):
+        self.reset()
+
+    def reset(self):
+        self.start_time = time.perf_counter()
+        return self.start_time
+
+    def get_delta(self):
+        prev_time = self.start_time
+        return self.reset() - prev_time
+
