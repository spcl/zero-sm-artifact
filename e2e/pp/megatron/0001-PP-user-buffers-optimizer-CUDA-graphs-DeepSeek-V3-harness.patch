+    # --- MoE Settings ---
+    model_cfg.moe_token_dispatcher_type = cfg.model.moe_token_dispatcher_type
+    model_cfg.moe_grouped_gemm = cfg.model.moe_grouped_gemm
+    model_cfg.moe_single_grouped_weight = cfg.model.moe_single_grouped_weight
