diff --git a/examples/zero_sm_pp/deepseek_mlperf/conf/model/671b.yaml b/examples/zero_sm_pp/deepseek_mlperf/conf/model/671b.yaml
new file mode 100755
index 000000000..5f9bc163a
--- /dev/null
+++ b/examples/zero_sm_pp/deepseek_mlperf/conf/model/671b.yaml
@@ -0,0 +1,125 @@
+# Full 671B model configuration
+# This uses defaults from HuggingFace config (no architecture overrides)
+
+model_size: "671b"
+
+mtp_num_layers: ${oc.decode:${oc.env:MTP_NUM_LAYERS,1}}
+mtp_loss_scaling_factor: ${oc.decode:${oc.env:MTP_LOSS_SCALING_FACTOR,0.1}}
+moe_router_topk: ${oc.decode:${oc.env:ROUTER_TOP_K,8}}
+moe_router_num_groups: ${oc.decode:${oc.env:ROUTER_NUM_GROUPS,8}}
+moe_router_group_topk: ${oc.decode:${oc.env:ROUTER_GROUP_TOP_K,4}}
+moe_router_topk_scaling_factor: ${oc.decode:${oc.env:ROUTER_TOP_K_SCALING_FACTOR,2.5}}
+# NOTE: all parallelism parameters except ETP must be set
+tensor_model_parallel_size: ${oc.decode:${oc.env:TENSOR_MODEL_PARALLEL,1}}
+pipeline_model_parallel_size: ${oc.decode:${oc.env:PIPELINE_MODEL_PARALLEL,1}}
+virtual_pipeline_model_parallel_size: ${oc.decode:${oc.env:INTERLEAVED_PIPELINE,null}}
+context_parallel_size: ${oc.decode:${oc.env:CONTEXT_PARALLEL,1}}
+expert_model_parallel_size: ${oc.decode:${oc.env:EXPERT_PARALLEL,1}}
+expert_tensor_parallel_size: ${oc.decode:${oc.env:EXPERT_TENSOR_PARALLEL,1}}
+pipeline_layout: ${oc.env:PIPELINE_LAYOUT,null}
+use_symmetric_memory_p2p: ${oc.decode:${oc.env:SYM_MEM_PP,False}}
+
+mcore_fsdp: ${oc.decode:${oc.env:USE_MCORE_FSDP,False}}
+
+# If True, use all-gather during the initial Megatron-FSDP parameter synchronization step.
+# Set to False to enable Cuda Graphs for FSDP.
+fsdp_all_gather_in_start_param_sync: ${oc.decode:${oc.env:FSDP_AG_PARAM_SYNC,True}}
+# Megatron-FSDP CUDA graph-safe grad/param handling (see megatron_fsdp distributed_data_parallel_config).
+megatron_fsdp_cuda_graph_mode: ${oc.decode:${oc.env:MEGATRON_FSDP_CUDA_GRAPH_MODE,False}}
+
+moe_token_dispatcher_type: ${oc.decode:${oc.env:MOE_TOKEN_DISPATCHER_TYPE,alltoall}}
+moe_flex_dispatcher_backend: ${oc.decode:${oc.env:MOE_FLEX_DISPATCHER_BACKEND,null}}
+moe_hybridep_num_sms: ${oc.decode:${oc.env:MOE_HYBRIDEP_NUM_SMS,32}}
+moe_hybridep_num_sms_preprocessing: ${oc.decode:${oc.env:MOE_HYBRIDEP_NUM_SMS_PREPROCESSING,108}}
+moe_grouped_gemm: ${oc.decode:${oc.env:MOE_GROUPED_GEMM,True}}
+moe_single_grouped_weight: ${oc.decode:${oc.env:MOE_SINGLE_GROUPED_WEIGHT,False}}
+moe_single_grouped_bias: ${oc.decode:${oc.env:MOE_SINGLE_GROUPED_BIAS,False}}
+moe_permute_fusion: ${oc.decode:${oc.env:MOE_PERMUTE_FUSION,True}}
+moe_router_fusion: ${oc.decode:${oc.env:MOE_ROUTER_FUSION,True}}
+moe_router_force_load_balancing: ${oc.decode:${oc.env:MOE_ROUTER_FORCE_LOAD_BALANCING,False}}
+moe_router_force_biased: ${oc.decode:${oc.env:MOE_ROUTER_FORCE_BIASED,null}}
+apply_rope_fusion: ${oc.decode:${oc.env:APPLY_ROPE_FUSION,False}}
+moe_router_dtype: ${oc.decode:${oc.env:MOE_ROUTER_DTYPE,fp32}}
+moe_aux_loss_coeff: ${oc.decode:${oc.env:MOE_AUX_LOSS_COEFF,0.01}}
+moe_expert_rank_capacity_factor: ${oc.decode:${oc.env:MOE_EXPERT_RANK_CAPACITY_FACTOR,null}}
+moe_paged_stash: ${oc.decode:${oc.env:MOE_PAGED_STASH,False}}
+moe_paged_stash_buffer_size_factor_cuda: ${oc.decode:${oc.env:MOE_PAGED_STASH_BUFFER_SIZE_FACTOR_CUDA,null}}
+moe_paged_stash_buffer_size_factor_cpu: ${oc.decode:${oc.env:MOE_PAGED_STASH_BUFFER_SIZE_FACTOR_CPU,null}}
+overlap_moe_expert_parallel_comm: ${oc.decode:${oc.env:OVERLAP_MOE_EXPERT_PARALLEL_COMM,False}}
+high_priority_a2a_comm_stream: ${oc.decode:${oc.env:HIGH_PRIORITY_A2A_COMM_STREAM,False}}
+delay_wgrad_compute: ${oc.decode:${oc.env:DELAY_WGRAD_COMPUTE,False}}
+overlap_dispatch_backward_with_experts_wgrad: ${oc.decode:${oc.env:OVERLAP_DISPATCH_BACKWARD_WITH_EXPERTS_WGRAD,False}}
+use_dynamic_comp_stream: ${oc.decode:${oc.env:USE_DYNAMIC_COMP_STREAM,False}}
+log_moe_overload_factor: ${oc.decode:${oc.env:LOG_MOE_OVERLOAD_FACTOR,False}}
+fused_residual_rmsnorm: ${oc.decode:${oc.env:FUSED_RESIDUAL_RMSNORM,True}}
+use_te_activation_func: ${oc.decode:${oc.env:USE_TE_ACTIVATION_FUNC,False}}
+
+# Fuse weight gradient accumulation to GEMMs.
+gradient_accumulation_fusion: ${oc.decode:${oc.env:GRAD_ACCUM_FUSION,False}}
+# Average gradients in collective operations - fuses scaling and reduction for gradient averaging.
+average_in_collective: ${oc.decode:${oc.env:AVERAGE_IN_COLLECTIVE,False}}
+
+micro_batch_size: ${oc.decode:${oc.env:MICRO_BATCH_SIZE,1}}
+global_batch_size: ${oc.decode:${oc.env:GLOBAL_BATCH_SIZE,${multiply:${oc.decode:${oc.env:MINIBS}},${floor_div:${multiply:${trainer.devices},${trainer.num_nodes}},${multiply:${multiply:${model.tensor_model_parallel_size},${model.pipeline_model_parallel_size}},${model.context_parallel_size}}}}}}
+
+encoder_seq_length: ${oc.decode:${oc.env:SEQ_LENGTH,4096}}
+recompute_modules: ${oc.env:RECOMPUTE_MODULES, ""}
+cuda_graph_implementation: ${oc.env:CUDA_GRAPH_IMPLEMENTATION, "none"}
+cuda_graph_modules: ${oc.env:CUDA_GRAPH_MODULES,null}
+cuda_graph_warmup_steps: ${oc.decode:${oc.env:CUDA_GRAPH_WARMUP_STEPS,null}}
+# Opt-in: torch.autograd.graph.set_override_stale_capture_stream(True) before train (CUDA graphs / FSDP).
+torch_override_stale_capture_stream: ${oc.decode:${oc.env:TORCH_OVERRIDE_STALE_CAPTURE_STREAM,False}}
+
+cpu_offloading: ${oc.decode:${oc.env:CPU_OFFLOADING,False}}
+cpu_offloading_num_layers: ${oc.decode:${oc.env:CPU_OFFLOADING_NUM_LAYERS,95}}
+cpu_offloading_retain_pinned_cpu_buffers: ${oc.decode:${oc.env:CPU_OFFLOADING_RETAIN_PINNED_CPU_BUFFERS,False}}
+
+# Fine-grained activation offloading
+# See https://github.com/NVIDIA/Megatron-LM/pull/1913 for details.
+fine_grained_activation_offloading: ${oc.decode:${oc.env:FINE_GRAINED_ACTIVATION_OFFLOADING,False}}
+# Allowed modules: [core_attn, attn_proj, expert_fc1, moe_act, attn_norm, mlp_norm, qkv_linear]
+offload_modules: ${oc.env:OFFLOAD_MODULES, ""}
+min_offloaded_tensor_size: ${oc.decode:${oc.env:MIN_OFFLOADED_TENSOR_SIZE,1048576}}
+# Max inflight D2H offloads per fine-grained offloading group name (see TransformerConfig).
+# Unset / null = do not cap (MCore default). Non-negative int when set.
+fine_grained_offloading_max_inflight_offloads: ${oc.decode:${oc.env:FINE_GRAINED_OFFLOADING_MAX_INFLIGHT_OFFLOADS,null}}
+
+seed: ${oc.decode:${oc.env:SEED,1234}}
+use_rng_tracker: ${oc.decode:${oc.env:USE_RNG_TRACKER,True}}
+fp8: ${oc.decode:${oc.env:FP8,False}}
+fp8_dot_product_attention: ${oc.decode:${oc.env:FP8_DPA,False}}
+fp8_output_proj: ${oc.decode:${oc.env:FP8_OUTPUT_PROJ,False}}
+fp4: ${oc.decode:${oc.env:FP4,False}}
+use_transformer_engine_op_fuser: ${oc.decode:${oc.env:USE_TE_OPS,False}}
+mla_down_proj_fusion: ${oc.decode:${oc.env:MLA_DOWN_PROJ_FUSION,False}}
+fp4_recipe: ${oc.decode:${oc.env:FP4_RECIPE,nvfp4}}
+nsys_profile:
+  enabled: ${oc.decode:${oc.env:PROFILE,False}}
+  start_step: ${oc.decode:${oc.env:PROFILE_START_STEP,10}}
+  end_step: ${oc.decode:${oc.env:PROFILE_END_STEP,12}}
+  ranks_str: ${oc.env:PROFILE_RANKS,0}  # Comma-separated PROFILE_RANKS env var, default to "0" if not set (parsed in Python)
+  gen_shape: ${oc.decode:${oc.env:GEN_SHAPE,False}}
+  nvtx_ranges: ${oc.decode:${oc.env:MBRIDGE_NVTX_RANGES,False}} # Set to True to enable NVTX profiling in both Nemo & MCore
+  use_pytorch_profiler: ${oc.decode:${oc.env:USE_PYTORCH_PROFILER,False}}
+  memory_profiler:
+    enable: ${oc.decode:${oc.env:ENABLE_MEMORY_PROFILER,False}}
+    file_prefix: ${oc.env:MEMORY_PROFILE_FILENAME,memdump}
+    # PyTorch memory snapshot (memory_viz). Independent of nsys PROFILE_START_STEP/END_STEP.
+    # MEMORY_PROFILE_START_STEP unset -> null: begin _record_memory_history at on_train_start (before WarmupCallback).
+    # Set to 0,1,... to begin when train_state.step reaches that value (main loop only; misses warmup capture).
+    start_step: ${oc.decode:${oc.env:MEMORY_PROFILE_START_STEP,null}}
+    # MEMORY_PROFILE_END_STEP unset -> null: dump at on_train_end. Set to N to dump after that train step ends.
+    end_step: ${oc.decode:${oc.env:MEMORY_PROFILE_END_STEP,null}}
+enable_perf_configs: ${oc.decode:${oc.env:ENABLE_PERF_CONFIGS,False}}
+
+
+nccl_communicator_config_path: ${oc.decode:${oc.env:NCCL_CFG_PATH,null}}
+sharp: ${oc.decode:${oc.env:SHARP,False}}
+use_tp_pp_dp_mapping: ${oc.decode:${oc.env:TP_PP_DP_MAPPING,False}}
+
+# Checkpointing
+resume_from_checkpoint: ${oc.env:LOAD_CHECKPOINT,null}
+dist_ckpt_format: ${if:${model.mcore_fsdp},fsdp_dtensor,torch_dist}
+dist_ckpt_parallel_load: ${oc.decode:${oc.env:DIST_CKPT_PARALLEL_LOAD,True}}
+
+tokenizer: "/tokenizer"  # mounted in config_mounts.sh
