     )
 
 
+_NCCL_UB_WARMUP_DONE = False
+
+
+def _serialized_nccl_ub_warmup(data_parallel_group):
+    """Count-consistent NCCL user-buffer warmup for pipeline parallelism.
+
+    Every rank inventories all data-parallel groups over the default group and
+    initializes them one at a time in a fixed global order, so all ranks run the
+    same number of global barriers and no two groups create NCCL resources
+    concurrently. Runs once per process.
+    """
+    global _NCCL_UB_WARMUP_DONE
+    if _NCCL_UB_WARMUP_DONE:
+        return
+    _NCCL_UB_WARMUP_DONE = True
+
+    my_ranks = tuple(torch.distributed.get_process_group_ranks(data_parallel_group))
+    gathered = [None] * torch.distributed.get_world_size()
+    torch.distributed.all_gather_object(gathered, my_ranks)
+    inventory = sorted({tuple(entry) for entry in gathered})
+
+    my_rank = torch.distributed.get_rank()
+    for ranks in inventory:
+        torch.distributed.barrier()
+        if my_rank in ranks:
+            tmp_warmup_tensor = torch.zeros([1], device="cuda")
+            torch.distributed.all_reduce(tmp_warmup_tensor, group=data_parallel_group)
+        torch.distributed.barrier()
+
