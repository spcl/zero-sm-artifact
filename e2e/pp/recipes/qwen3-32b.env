# Qwen3-32B: TP8 PP2 VPP2 DP4, MBS2 GBS64 (GA8), sequence 4096, BF16, mock data.
LABEL=Qwen3-32B
GPUS=64 TP=8 PP=2 VPP=2 CP=1 EP=1 MBS=2 GBS=64 SEQ=4096
ENV=(CUDA_DEVICE_MAX_CONNECTIONS=1)
ARGS=(
  --tensor-model-parallel-size $TP --pipeline-model-parallel-size $PP --context-parallel-size $CP
  --num-virtual-stages-per-pipeline-rank $VPP --sequence-parallel
  --micro-batch-size $MBS --global-batch-size $GBS --seq-length $SEQ --max-position-embeddings 40960
  --vocab-size 151936
  --num-layers 64 --hidden-size 5120 --ffn-hidden-size 25600 --num-attention-heads 64 --kv-channels 128
  --group-query-attention --num-query-groups 8 --qk-layernorm
  --normalization RMSNorm --norm-epsilon 1e-6 --swiglu --untie-embeddings-and-output-weights
  --position-embedding-type rope --use-rotary-position-embeddings --rotary-percent 1.0 --rotary-base 1000000
  --attention-dropout 0.0 --hidden-dropout 0.0 --no-masked-softmax-fusion --attention-softmax-in-fp32
  --clip-grad 1.0 --weight-decay 0.01 --lr 1e-6 --min-lr 1e-7 --lr-decay-style cosine --lr-warmup-iters 0
  --adam-beta1 0.9 --adam-beta2 0.999 --adam-eps 1e-8
  --recompute-granularity full --recompute-method uniform --recompute-num-layers 1
)
