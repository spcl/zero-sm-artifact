# DeepSeek-V3 with 16 experts: TP1 PP8 VPP4 EP4 DP4, MBS1 GBS64 (GA16), sequence 4096, MXFP8,
# full-iteration CUDA graphs, C4 data (e2e/pp/deepseek_data.sh). Megatron-Bridge Hydra harness from the PP Megatron patch.
LABEL=DeepSeek-V3
GPUS=32 TP=1 PP=8 VPP=4 CP=1 EP=4 MBS=1 GBS=64 SEQ=4096
LAUNCH=deepseek
DEPS=deepseek
# Same PyTorch build as the image the results were measured with; Transformer Engine with the fused grouped MLP.
IMAGE=nvcr.io#nvidia/pytorch:26.08-py3
ENV=(
  MODEL_SIZE=16expert DATASET=8b MOCK_DATASET=False USE_SYNTHETIC_DATA=0 SEED=1234
  TENSOR_MODEL_PARALLEL=$TP PIPELINE_MODEL_PARALLEL=$PP INTERLEAVED_PIPELINE=$VPP CONTEXT_PARALLEL=$CP
  EXPERT_PARALLEL=$EP MICRO_BATCH_SIZE=$MBS GLOBAL_BATCH_SIZE=$GBS MINIBS=16
  "PIPELINE_LAYOUT=Et*2|(t*2|)*28t|t|tmL"
  MAX_STEPS=${ITERS:-100} LOG_EVERY_N_STEPS=10 VAL_CHECK_INTERVAL=10 LIMIT_VAL_BATCHES=1 EVAL_BATCH_SIZE=64
  LR_WARMUP_ITERS=16 LR_DECAY_ITERS=11996 MIN_LR=1e-6 TRAIN_ONLY=0
  FP8=True FP8_PARAM_GATHER=True FP8_DPA=True REUSE_GRAD_BUF_FOR_MXFP8_PARAM_AG=True
  MLPERF_LINEAR_PRECISION=fp8 MLPERF_ATTN_PRECISION=bfloat16 MLPERF_COMM_PRECISION=bfloat16 MODEL_TFLOP_PER_SAMPLE=1068
  MOE_TOKEN_DISPATCHER_TYPE=flex MOE_FLEX_DISPATCHER_BACKEND=hybridep MOE_HYBRIDEP_NUM_SMS=32
  MOE_HYBRIDEP_NUM_SMS_PREPROCESSING=32 NUM_OF_HYBRID_EP_RANKS_PER_NVLINK_DOMAIN=4 USE_MNNVL=1
  MOE_ROUTER_FORCE_LOAD_BALANCING=True MOE_SINGLE_GROUPED_WEIGHT=True MOE_EXPERT_RANK_CAPACITY_FACTOR=2
  MOE_PAGED_STASH=True MOE_PAGED_STASH_BUFFER_SIZE_FACTOR_CUDA=0.5 MOE_PAGED_STASH_BUFFER_SIZE_FACTOR_CPU=1
  MOE_AUX_LOSS_COEFF=0.01 MOE_PERMUTE_FUSION=True MOE_ROUTER_FUSION=True MOE_ROUTER_DTYPE=bf16
  APPLY_ROPE_FUSION=True MLA_DOWN_PROJ_FUSION=True GRAD_ACCUM_FUSION=True AVERAGE_IN_COLLECTIVE=True
  OVERLAP_MOE_EXPERT_PARALLEL_COMM=True OVERLAP_DISPATCH_BACKWARD_WITH_EXPERTS_WGRAD=False
  HIGH_PRIORITY_A2A_COMM_STREAM=True USE_DYNAMIC_COMP_STREAM=True DELAY_WGRAD_COMPUTE=True
  USE_TE_OPS=True NVTE_CUTEDSL_FUSED_GROUPED_MLP=1 CUDNN_FE_GROUPED_GEMM_DYNAMIC_MNKL=True
  CUDA_GRAPH_IMPLEMENTATION=full_iteration CUDA_GRAPH_MODULES= CUDA_GRAPH_WARMUP_STEPS=2
  OPTIMIZER_CG=True ON_DEVICE_CLIP_GRAD=True CUDNNFE_CLUSTER_OVERLAP_MARGIN=8 NVTE_EXT_MARGIN_SM=16
  RECOMPUTE_MODULES= USE_DIST_OPTIMIZER=True OVERLAP_GRAD_REDUCE=True OVERLAP_PARAM_GATHER=True
  USE_PRECISION_AWARE_OPTIMIZER=True NCCL_UB_DP=True NCCL_GRAPH_REGISTER=0
  CHECKPOINT_SAVE_INTERVAL=-1 SAVE_OPTIMIZER=False SAVE_RNG_STATE=False FORCE_SUCCESS_STATUS=0
  PROFILE=False USE_PYTORCH_PROFILER=False ENABLE_MEMORY_PROFILER=False NTRACE_ENABLE=0
  NVTE_FWD_LAYERNORM_SM_MARGIN=0 NVTE_BWD_LAYERNORM_SM_MARGIN=0 NVTE_NORM_FWD_USE_CUDNN=1 NVTE_NORM_BWD_USE_CUDNN=1
  NVTE_ALLOW_NONDETERMINISTIC_ALGO=0 TORCH_NCCL_HIGH_PRIORITY=1 CUDA_DEVICE_MAX_CONNECTIONS=32
  PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,graph_capture_record_stream_reuse:True
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=False TORCH_CPP_LOG_LEVEL=ERROR
  PYTHONWARNINGS=ignore::FutureWarning,ignore::UserWarning
)
# As run on each platform.
ENV_gb200=(FP8_OUTPUT_PROJ=True WARMUP_TRAIN_STEPS=0 WARMUP_VALIDATION_STEPS=0 NCCL_LOCAL_REGISTER=1
  NCCL_NET_GDR_LEVEL=PHB NCCL_NET_GDR_C2C=1)
ENV_b200=(WARMUP_TRAIN_STEPS=3 WARMUP_VALIDATION_STEPS=3 NCCL_LOCAL_REGISTER=0)
HYDRA_b200=(data.num_workers=0)
