# Nemotron-4 15B: TP4 PP2 VPP2 DP4, MBS2 GBS32 (GA4), sequence 4096, FP8 (delayed scaling), mock data.
LABEL=Nemotron-15B
GPUS=32 TP=4 PP=2 VPP=2 CP=1 EP=1 MBS=2 GBS=32 SEQ=4096
ENV=(CUDA_DEVICE_MAX_CONNECTIONS=1)
ARGS=(
  --tensor-model-parallel-size $TP --pipeline-model-parallel-size $PP --context-parallel-size $CP
  --num-virtual-stages-per-pipeline-rank $VPP --sequence-parallel
  --micro-batch-size $MBS --global-batch-size $GBS --seq-length $SEQ --max-position-embeddings 4096
  --fp8-format hybrid --fp8-recipe delayed --fp8-param-gather
  --vocab-size 256001
  --num-layers 32 --hidden-size 6144 --ffn-hidden-size 24576 --num-attention-heads 48 --kv-channels 128
  --group-query-attention --num-query-groups 8
  --normalization LayerNorm --norm-epsilon 1e-5 --squared-relu --untie-embeddings-and-output-weights
  --position-embedding-type rope --rotary-percent 1.0 --rotary-base 10000
  --attention-dropout 0.0 --hidden-dropout 0.0 --no-masked-softmax-fusion --attention-softmax-in-fp32
  --clip-grad 1.0 --weight-decay 0.1 --lr 1e-6 --min-lr 1e-7 --lr-decay-style cosine --lr-warmup-iters 0
  --adam-beta1 0.9 --adam-beta2 0.999 --adam-eps 1e-8
)
