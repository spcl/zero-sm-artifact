# Qwen3-Next 80B-A3B shape (48 layers, 512 experts, top-10) with standard GQA attention:
# TP1 PP8 VPP2 EP8 DP8, MBS1 GBS64 (GA8), sequence 4096, BF16, HybridEP dispatcher, mock data.
LABEL=Qwen3-Next
GPUS=64 TP=1 PP=8 VPP=2 CP=1 EP=8 MBS=1 GBS=64 SEQ=4096
ENV=(CUDA_DEVICE_MAX_CONNECTIONS=1)
ARGS=(
  --tensor-model-parallel-size $TP --pipeline-model-parallel-size $PP --context-parallel-size $CP
  --expert-model-parallel-size $EP --expert-tensor-parallel-size 1
  --num-virtual-stages-per-pipeline-rank $VPP --overlap-moe-expert-parallel-comm --delay-wgrad-compute
  --micro-batch-size $MBS --global-batch-size $GBS --seq-length $SEQ --max-position-embeddings 4096
  --vocab-size 32768
  --num-layers 48 --decoder-first-pipeline-num-layers 6 --decoder-last-pipeline-num-layers 6
  --hidden-size 2048 --ffn-hidden-size 5632 --num-attention-heads 16 --kv-channels 256
  --group-query-attention --num-query-groups 2
  --normalization RMSNorm --norm-epsilon 1e-6 --swiglu --untie-embeddings-and-output-weights
  --position-embedding-type rope --rotary-base 1000000
  --attention-dropout 0.0 --hidden-dropout 0.0
  --clip-grad 1.0 --weight-decay 0.1 --lr 1e-5 --min-lr 1e-6 --lr-decay-style cosine --lr-warmup-iters 0
  --adam-beta1 0.9 --adam-beta2 0.95
  --num-experts 512 --moe-layer-freq '([1]*48)' --moe-ffn-hidden-size 512 --moe-router-topk 10
  --moe-token-dispatcher-type flex --moe-flex-dispatcher-backend hybridep --moe-hybridep-num-sms 32
  --moe-grouped-gemm --moe-permute-fusion --moe-router-dtype fp32
  --moe-router-load-balancing-type aux_loss --moe-aux-loss-coeff 1e-3 --moe-router-force-load-balancing
  --moe-expert-capacity-factor 1.0 --moe-pad-expert-input-to-capacity
  --recompute-granularity selective
)
