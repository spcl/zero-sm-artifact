# Llama-3 70B: TP4 PP4 VPP5 CP2 DP2, MBS1 GBS64 (GA32), sequence 8192, BF16, mock data.
LABEL=Llama-70B
GPUS=64 TP=4 PP=4 VPP=5 CP=2 EP=1 MBS=1 GBS=64 SEQ=8192
ENV=(CUDA_DEVICE_MAX_CONNECTIONS=1)
ARGS=(
  --tensor-model-parallel-size $TP --pipeline-model-parallel-size $PP --context-parallel-size $CP
  --num-virtual-stages-per-pipeline-rank $VPP --sequence-parallel --ddp-average-in-collective
  --micro-batch-size $MBS --global-batch-size $GBS --seq-length $SEQ --max-position-embeddings 8192
  --vocab-size 128256
  --num-layers 80 --hidden-size 8192 --ffn-hidden-size 28672 --num-attention-heads 64 --kv-channels 128
  --group-query-attention --num-query-groups 8
  --normalization RMSNorm --norm-epsilon 1e-5 --swiglu --untie-embeddings-and-output-weights
  --position-embedding-type rope --use-rotary-position-embeddings --rotary-percent 1.0 --rotary-base 500000
  --attention-dropout 0.0 --hidden-dropout 0.0 --no-masked-softmax-fusion --attention-softmax-in-fp32
  --clip-grad 1.0 --weight-decay 0.1 --lr 3e-4 --min-lr 3e-5 --lr-decay-style cosine --lr-warmup-iters 0
  --adam-beta1 0.9 --adam-beta2 0.95 --adam-eps 1e-8
  --manual-gc --manual-gc-interval 100
)
