# Llama-3.1 405B: TP4 PP8 VPP2 DP2, MBS1 GBS64 (GA32), sequence 8192, FP8 (delayed scaling), mock data.
LABEL=Llama-405B
GPUS=64 TP=4 PP=8 VPP=2 CP=1 EP=1 MBS=1 GBS=64 SEQ=8192
ENV=()
ENV_gb200=(CUDA_DEVICE_MAX_CONNECTIONS=1)   # as run: not set on B200
ARGS=(
  --tensor-model-parallel-size $TP --pipeline-model-parallel-size $PP --context-parallel-size $CP
  --num-virtual-stages-per-pipeline-rank $VPP --sequence-parallel --ddp-average-in-collective
  --micro-batch-size $MBS --global-batch-size $GBS --seq-length $SEQ --max-position-embeddings 131072
  --fp8-format hybrid --fp8-recipe delayed --fp8-param-gather --grad-reduce-in-bf16
  --vocab-size 128256
  --num-layers 126 --decoder-first-pipeline-num-layers 16 --decoder-last-pipeline-num-layers 14
  --hidden-size 16384 --ffn-hidden-size 53248 --num-attention-heads 128 --kv-channels 128
  --group-query-attention --num-query-groups 8
  --normalization RMSNorm --norm-epsilon 1e-5 --swiglu --untie-embeddings-and-output-weights
  --position-embedding-type rope --use-rotary-position-embeddings --rotary-percent 1.0 --rotary-base 500000
  --use-rope-scaling --rope-scaling-factor 8.0
  --attention-dropout 0.0 --hidden-dropout 0.0 --no-masked-softmax-fusion --attention-softmax-in-fp32
  --clip-grad 1.0 --weight-decay 0.1 --lr 3e-4 --min-lr 3e-5 --lr-decay-style cosine --lr-warmup-iters 0
  --adam-beta1 0.9 --adam-beta2 0.95 --adam-eps 1e-8
  --recompute-granularity full --recompute-method uniform --recompute-num-layers 1
  --empty-unused-memory-level 1 --manual-gc --manual-gc-interval 100
)
