# DeepSeek-V3-G: DeepSeek-V3 with 16 experts, 32 GPUs, DP32 EP4, MBS1 GBS64 (GA2), seq 4K, MXFP8,
# full-iteration CUDA graphs, C4 data (e2e/pp/deepseek_data.sh). Hydra harness of the PP Megatron tree.
STACK=deepseek MBS=1 GBS=64 SEQ=4096 ITERS=${ITERS:-100} WARMUP=10
IMAGE=nvcr.io#nvidia/pytorch:26.08-py3   # same image as the DeepSeek-V3 PP recipe
case $PLATFORM in
  gb200) NODES=8 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=4 ARMS="legacy symmetric_stmc ce_multicast"
         CE_AG_MULTICAST_THRESHOLD= ;;   # B200 CE arm as measured: path chosen by NCCL
esac
ENV=(
  MODEL_SIZE=16expert DATASET=8b MOCK_DATASET=False SEED=1234
  TENSOR_MODEL_PARALLEL=1 PIPELINE_MODEL_PARALLEL=1 INTERLEAVED_PIPELINE=null CONTEXT_PARALLEL=1 EXPERT_PARALLEL=4
  MICRO_BATCH_SIZE=$MBS GLOBAL_BATCH_SIZE=$GBS MINIBS=2 TP_PP_DP_MAPPING=False
  LOG_EVERY_N_STEPS=10 VAL_CHECK_INTERVAL=10 LIMIT_VAL_BATCHES=1 LR_WARMUP_ITERS=16 MIN_LR=1e-6
  WARMUP_TRAIN_STEPS=0 WARMUP_VALIDATION_STEPS=0
  FP8=True FP8_PARAM_GATHER=True FP8_DPA=False FP8_OUTPUT_PROJ=True REUSE_GRAD_BUF_FOR_MXFP8_PARAM_AG=True
  MLPERF_LINEAR_PRECISION=fp8 MLPERF_ATTN_PRECISION=bfloat16 MLPERF_COMM_PRECISION=bfloat16 MODEL_TFLOP_PER_SAMPLE=1068
  CUDA_GRAPH_IMPLEMENTATION=full_iteration CUDA_GRAPH_MODULES= CUDA_GRAPH_WARMUP_STEPS=2
  OPTIMIZER_CG=False ON_DEVICE_CLIP_GRAD=False TORCH_OVERRIDE_STALE_CAPTURE_STREAM=True
  MEGATRON_FSDP_CUDA_GRAPH_MODE=True FSDP_AG_PARAM_SYNC=False FINE_GRAINED_OFFLOADING_MAX_INFLIGHT_OFFLOADS=1
  USE_MCORE_FSDP=True NCCL_UB_DP=True FSDP_MANUAL_REGISTRATION=True NUM_DISTOPT_INSTANCES=1
  OUTER_DP_SHARDING_STRATEGY=no_shard OVERLAP_PARAM_GATHER_WITH_OPTIM_STEP=False BUCKET_SIZE=null
  USE_PRECISION_AWARE_OPTIMIZER=True GRAD_ACCUM_FUSION=False AVERAGE_IN_COLLECTIVE=True
  DEFER_EMBEDDING_WGRAD_COMPUTE=False DELAY_WGRAD_COMPUTE=False
  MOE_TOKEN_DISPATCHER_TYPE=flex MOE_FLEX_DISPATCHER_BACKEND=hybridep MOE_HYBRIDEP_NUM_SMS=32
  MOE_HYBRIDEP_NUM_SMS_PREPROCESSING=32 NUM_OF_HYBRID_EP_RANKS_PER_NVLINK_DOMAIN=4 USE_MNNVL=1
  MOE_ROUTER_FORCE_LOAD_BALANCING=True MOE_EXPERT_RANK_CAPACITY_FACTOR=2 MOE_PAGED_STASH=True
  MOE_PAGED_STASH_BUFFER_SIZE_FACTOR_CUDA=2.0 MOE_PAGED_STASH_BUFFER_SIZE_FACTOR_CPU=1 STASH_MODULES=expert_fc1
  OVERLAP_MOE_EXPERT_PARALLEL_COMM=False OVERLAP_DISPATCH_BACKWARD_WITH_EXPERTS_WGRAD=False
  USE_DYNAMIC_COMP_STREAM=True HIGH_PRIORITY_A2A_COMM_STREAM=True MOE_PERMUTE_FUSION=True MOE_ROUTER_FUSION=True
  APPLY_ROPE_FUSION=True MLA_DOWN_PROJ_FUSION=True MOE_ROUTER_DTYPE=bf16 MOE_AUX_LOSS_COEFF=0.01
  USE_TE_OPS=True MOE_SINGLE_GROUPED_WEIGHT=True NVTE_CUTEDSL_FUSED_GROUPED_MLP=1 CUDNN_FE_GROUPED_GEMM_DYNAMIC_MNKL=1
  RECOMPUTE_MODULES= CHECKPOINT_SAVE_INTERVAL=-1 CKPT_EVERY_VALIDATION=False LOAD_CHECKPOINT= LOAD_CHECKPOINTS_DIR=
  SAVE_OPTIMIZER=False SAVE_RNG_STATE=False LOAD_OPTIMIZER=False LOAD_RNG_STATE=False FORCE_SUCCESS_STATUS=0
  PROFILE=False USE_PYTORCH_PROFILER=False ENABLE_MEMORY_PROFILER=False NTRACE_ENABLE=0
  CUDA_DEVICE_MAX_CONNECTIONS=32 TORCH_NCCL_HIGH_PRIORITY=1
  PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,graph_capture_record_stream_reuse:True
  NVTE_NORM_FWD_USE_CUDNN=1 NVTE_NORM_BWD_USE_CUDNN=1 NVTE_FWD_LAYERNORM_SM_MARGIN=0 NVTE_BWD_LAYERNORM_SM_MARGIN=0
  NVTE_EXT_MARGIN_SM=16 NVTE_ALLOW_NONDETERMINISTIC_ALGO=0 CUDNNFE_CLUSTER_OVERLAP_MARGIN=8
  NCCL_GRAPH_REGISTER=0 NCCL_LOCAL_REGISTER=1 NCCL_MIN_CTAS=1 NCCL_MIN_NCHANNELS=1
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=False TORCH_CPP_LOG_LEVEL=ERROR
  PYTHONWARNINGS=ignore::FutureWarning,ignore::UserWarning
)
