# Llama-405B-G: Llama 3.1 405B, DP32 TP2, MBS1 GBS64 (GA2), seq 8K; 96 of 126 layers on B200 (memory)
STACK=nemo MODEL=llama31_405b TP=2 MBS=1 GBS=64 SEQ=8192 ITERS=${ITERS:-100} WARMUP=10
case $PLATFORM in
  gb200) NODES=16 LAYERS=126 RECOMPUTE=126 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=8 LAYERS=96 RECOMPUTE=96 ARMS="legacy symmetric_stmc ce_multicast" ;;
esac
