# Llama-70B-H: Llama 3 70B, DP32 TP2, MBS1 GBS64 (GA2), seq 8K
STACK=nemo MODEL=llama3_70b TP=2 MBS=1 GBS=64 SEQ=8192 ITERS=${ITERS:-100} WARMUP=10
case $PLATFORM in
  gb200) NODES=16 LAYERS=80 RECOMPUTE=80 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=8 LAYERS=80 RECOMPUTE=80 ARMS="legacy symmetric_stmc ce_multicast" ;;
esac
