# Qwen3-32B-H: Qwen3 32B, 64 GPUs, DP32 TP2, MBS1 GBS64 (GA2), seq 4K
STACK=nemo MODEL=qwen3_32b TP=2 MBS=1 GBS=64 SEQ=4096 ITERS=${ITERS:-100} WARMUP=10
case $PLATFORM in
  gb200) NODES=16 LAYERS=64 RECOMPUTE=64 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=8 LAYERS=64 RECOMPUTE=64 ARMS="legacy symmetric_stmc ce_multicast" WARMUP=9 ;;
esac
