# Nemotron-15B-G1: Nemotron-4 15B, 32 GPUs, DP32 TP1, MBS4 GBS256 (GA2), seq 4K
STACK=nemo MODEL=nemotron4_15b TP=1 MBS=4 GBS=256 SEQ=4096 ITERS=${ITERS:-100} WARMUP=10
case $PLATFORM in
  gb200) NODES=8 LAYERS=32 RECOMPUTE=0 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=4 LAYERS=32 RECOMPUTE=0 ARMS="legacy symmetric_stmc ce_multicast" WARMUP=9 ;;
esac
