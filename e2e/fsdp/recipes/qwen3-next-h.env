# Qwen3-Next-H: Qwen3-Next 80B-A3B (gated DeltaNet + attention, 512 experts), 64 GPUs, DP64 EP2, MBS1 GBS64 (GA1),
# seq 4K, BF16, HybridEP dispatcher, mock data
STACK=megatron TP=1 MBS=1 GBS=64 SEQ=4096
ENV=(FLA_CACHE_RESULTS=1)
case $PLATFORM in
  gb200) NODES=16 ITERS=${ITERS:-50} WARMUP=20 WARMUP_SESSION=1
         ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=8 ITERS=${ITERS:-100} WARMUP=10 ARMS="legacy symmetric_stmc ce_multicast"
         CE_AG_MULTICAST_THRESHOLD= ;;   # B200 CE arm as measured: path chosen by NCCL
esac
ARGS=(
  --distributed-backend nccl --distributed-timeout-minutes 15
  --tensor-model-parallel-size 1 --pipeline-model-parallel-size 1 --expert-model-parallel-size 2
  --expert-tensor-parallel-size 1 --context-parallel-size 1 --micro-batch-size $MBS --global-batch-size $GBS
  --eval-iters 0 --eval-interval 1000 --timing-log-level 2
  --tokenizer-type NullTokenizer --vocab-size 151936 --padded-vocab-size 151936 --make-vocab-size-divisible-by 1
  --num-workers 0 --seq-length $SEQ --max-position-embeddings 262144
  --num-layers 48 --hidden-size 2048 --ffn-hidden-size 5120 --num-attention-heads 16 --num-query-groups 2
  --kv-channels 256 --experimental-attention-variant gated_delta_net --linear-attention-freq 4
  --linear-conv-kernel-dim 4 --linear-key-head-dim 128 --linear-value-head-dim 128 --linear-num-key-heads 16
  --linear-num-value-heads 32 --num-experts 512 --moe-layer-freq 1 --moe-ffn-hidden-size 512
  --moe-shared-expert-intermediate-size 512 --moe-router-dtype fp32 --moe-router-score-function softmax
  --moe-router-topk 10 --moe-router-load-balancing-type global_aux_loss --moe-aux-loss-coeff 0.001
  --moe-token-dispatcher-type flex --moe-flex-dispatcher-backend hybridep --moe-hybridep-num-sms 32
  --rotary-base 10000000 --rotary-percent 0.25 --normalization RMSNorm --norm-epsilon 1e-06
  --attention-dropout 0.0 --hidden-dropout 0.0 --clip-grad 1.0 --weight-decay 0.1 --init-method-std 0.02
  --ddp-bucket-size 40000000 --data-parallel-sharding-strategy optim_grads_params --ckpt-format fsdp_dtensor
  --megatron-fsdp-main-grads-dtype bf16 --megatron-fsdp-grad-comm-dtype bf16
  --lr 3.9e-06 --min-lr 3.9e-07 --lr-decay-style cosine --lr-warmup-iters 0 --adam-beta1 0.9 --adam-beta2 0.95
  --seed 1234 --use-mcore-models --use-flash-attn --disable-bias-linear --untie-embeddings-and-output-weights
  --group-query-attention --qk-layernorm --attention-output-gate --apply-layernorm-1p --swiglu --bf16
  --mock-data --no-create-attention-mask-in-dataloader --moe-shared-expert-gate --moe-grouped-gemm
  --moe-permute-fusion --moe-router-force-load-balancing --use-megatron-fsdp --init-model-with-meta-device
  --megatron-fsdp-max-pool-double-buffer --no-megatron-fsdp-validate-param-dtensors
  --no-megatron-fsdp-eager-dcp-metadata --use-nccl-ub --fsdp-manual-registration --no-gradient-accumulation-fusion
  --calculate-per-token-loss --log-throughput --enable-experimental --transformer-impl transformer_engine
  --position-embedding-type rope --split 99,1,0
)
