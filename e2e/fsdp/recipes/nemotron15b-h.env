# Nemotron-15B-H: Nemotron-4 15B, 32 GPUs, DP8 TP4, MBS2 GBS32 (GA2), seq 4K
STACK=nemo MODEL=nemotron4_15b TP=4 MBS=2 GBS=32 SEQ=4096 ITERS=${ITERS:-100} WARMUP=10
case $PLATFORM in
  gb200) NODES=8 LAYERS=32 RECOMPUTE=0 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=4 LAYERS=32 RECOMPUTE=0 ARMS="legacy ce_multicast" ;;
esac
