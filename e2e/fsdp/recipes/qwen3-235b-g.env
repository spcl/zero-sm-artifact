# Qwen3-235B-G: Qwen3-235B-A22B, 64 GPUs, DP64 EP2, MBS1 GBS64 (GA1), seq 16K, BF16, HybridEP dispatcher, mock data
STACK=megatron TP=1 MBS=1 GBS=64 SEQ=16384
case $PLATFORM in
  gb200) NODES=16 ITERS=${ITERS:-50} WARMUP=20 ARMS="symmetric_st symmetric_stmc ce_unicast ce_multicast legacy" ;;
  b200)  NODES=8 ITERS=${ITERS:-100} WARMUP=10 ARMS="legacy symmetric_stmc ce_multicast"
         CE_AG_MULTICAST_THRESHOLD= ;;   # B200 CE arm as measured: path chosen by NCCL
esac
ARGS=(
  --distributed-backend nccl --distributed-timeout-minutes 15
  --tensor-model-parallel-size 1 --pipeline-model-parallel-size 1 --expert-model-parallel-size 2
  --expert-tensor-parallel-size 1 --context-parallel-size 1 --micro-batch-size $MBS --global-batch-size $GBS
  --eval-iters 0 --eval-interval 1000 --logging-level 40 --timing-log-level 0 --no-barrier-with-level-1-timing
  --tokenizer-type NullTokenizer --vocab-size 151936 --make-vocab-size-divisible-by 1187 --num-workers 0
  --seq-length $SEQ --max-position-embeddings 40960
  --num-layers 94 --hidden-size 4096 --ffn-hidden-size 12288 --num-attention-heads 64 --num-query-groups 4
  --kv-channels 128 --num-experts 128 --moe-layer-freq 1 --moe-ffn-hidden-size 1536
  --moe-router-dtype fp32 --moe-router-score-function softmax --moe-router-topk 8
  --moe-router-load-balancing-type aux_loss --moe-aux-loss-coeff 0.001
  --moe-token-dispatcher-type flex --moe-flex-dispatcher-backend hybridep --moe-hybridep-num-sms 32
  --rotary-base 1000000 --rotary-percent 1.0 --rotary-seq-len-interpolation-factor 1
  --normalization RMSNorm --norm-epsilon 1e-06 --attention-dropout 0.0 --hidden-dropout 0.0
  --clip-grad 1.0 --weight-decay 0.1 --init-method-std 0.02 --ddp-bucket-size 40000000
  --data-parallel-sharding-strategy optim_grads_params --ckpt-format fsdp_dtensor
  --megatron-fsdp-main-grads-dtype bf16 --megatron-fsdp-grad-comm-dtype bf16
  --recompute-granularity full --recompute-method uniform --recompute-num-layers 1
  --cross-entropy-fusion-impl native --lr 3.9e-06 --min-lr 3.9e-07 --lr-decay-style cosine --lr-warmup-iters 0
  --adam-beta1 0.9 --adam-beta2 0.95 --seed 43117 --use-mcore-models --use-flash-attn --disable-bias-linear
  --untie-embeddings-and-output-weights --group-query-attention --qk-layernorm --swiglu --bf16
  --mock-data --no-create-attention-mask-in-dataloader --moe-grouped-gemm --moe-permute-fusion
  --moe-router-force-load-balancing --use-megatron-fsdp --init-model-with-meta-device
  --megatron-fsdp-max-pool-double-buffer --use-nccl-ub --fsdp-manual-registration --no-gradient-accumulation-fusion
  --calculate-per-token-loss --log-throughput --enable-experimental --transformer-impl transformer_engine
  --position-embedding-type rope --split 99,1,0
)
